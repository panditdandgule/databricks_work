#####################################
Incremental Load Logic

Used for:

Daily execution
New records
Updated records
Step 1: Create Metadata Table
##########################################
CREATE TABLE metadata.job_control
(
    job_name STRING,
    last_processed_timestamp TIMESTAMP
);
`

##########step2 Read last_processed_timestamp from watermark
watermark = spark.sql("""
SELECT last_processed_timestamp
FROM metadata.job_control
WHERE job_name='arc_844_load'
""").collect()[0][0]


###########Step3 Read only changed records
incremental_query = f"""
(
SELECT *
FROM ARC_VIEW_844
WHERE LAST_UPDATED > '{watermark}'
) src
"""

##Only new/updated rows are loaded.
incremental_df = (
    spark.read
    .format("jdbc")
    .option("url", jdbc_url)
    .option("dbtable", incremental_query)
    .option("user", username)
    .option("password", password)
    .load()
)

########step4 Merge into bronze
from delta.tables import DeltaTable

bronze_tbl = DeltaTable.forName(
    spark,
    "bronze.arc_844"
)

(
    bronze_tbl.alias("t")
    .merge(
        incremental_df.alias("s"),
        "t.id_340b = s.id_340b"
    )
    .whenMatchedUpdateAll()
    .whenNotMatchedInsertAll()
    .execute()
)


######step5 Update Watermark
latest_ts = incremental_df.agg(
    {"last_updated": "max"}
).collect()[0][0]

#########################Silver Layer Processing###############################

silver_844 = (
    spark.table("bronze.arc_844")
    .withColumn(
        "entity_name",
        F.upper(F.trim("entity_name"))
    )
    .withColumn(
        "address",
        F.upper(F.trim("address"))
    )
)

silver_844.write \
    .mode("overwrite") \
    .saveAsTable("silver.arc_844")
	
##############Matching Rules###################
matched_df = (
    spark.table("silver.arc_844")
    .crossJoin(
        spark.table("silver.arc_867")
    )
)

The solution follows a Bronze-Silver-Gold Lakehouse architecture in Azure Databricks. 
During the initial migration, a full load ingests all historical data from Redshift into Bronze Delta tables. 
For ongoing processing, incremental loads use a watermark-based approach to retrieve only new or updated records and 
merge them into Delta tables using Delta Lake MERGE operations. 
The data then flows through cleansing, matching, fuzzy matching, and eligibility classification layers before being published to Gold business datasets and consumed by Qlik Sense through Databricks SQL views.

